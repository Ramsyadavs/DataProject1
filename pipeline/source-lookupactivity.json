{
	"name": "source-lookupactivity",
	"properties": {
		"activities": [
			{
				"name": "serchingdata-activity",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from [ctrl].[table_config] where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_AzureSqlTable",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "install every datafile",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "serchingdata-activity",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('serchingdata-activity').output.firstRow",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "injesion from source to silver",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Script",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "source-to-sink",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Script",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "insert into ctrl.audit_log(adf_run_id,table_id,stage,status,start_time)values('a1',1,'source-to-silver','In-progress',SYSUTCDATETIME())",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			}
		},
		"annotations": []
	}
}